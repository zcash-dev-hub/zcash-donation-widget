  "description": "Embeddable shielded donation / tipping widget for Zcash TESTNET. Zero backend, no custody, no spending keys.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
